{
  "ConnectionStrings": {
    "DefaultConnection": "Server=MAJD;Database=TimePlannerDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "http://localhost:5171/",
    "Audience": "http://localhost:5171/",
    "Secret": ""
  },
  "FrontendBaseUrl": "http://localhost:5173",
  "PostmarkSettings": {
    "FromEmail": "confirm@avkrysset.no",
    "FromName": "Confirm Avkrysset",
    "ServerToken": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Logging": {},
  "AllowedHosts": "*"
}
